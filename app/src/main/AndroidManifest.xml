<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No <uses-permission> on purpose:
        - no INTERNET (the app never talks to a server)
        - no RECORD_AUDIO (we only ask Android "is speech available?", we never listen)
    -->

    <!-- On Android 11+ an app can only "see" other apps if it says so here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BondhuBench">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BondhuBench">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
